# Local environments, package caches and operating-system files.
.DS_Store
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# Publication staging and generated website output.
/.publication/
/arxiv/*
!/arxiv/README.md
!/arxiv/DIMENSION_BOUNDS.md
!/arxiv/sharp_dimension_bounds_8_and_4/
!/arxiv/ideal_four_dimensional_volume_and_structure/
!/arxiv/hyperbolic_coxeter_dimension_bounds/
/arxiv/sharp_dimension_bounds_8_and_4/*
/arxiv/ideal_four_dimensional_volume_and_structure/*
/arxiv/hyperbolic_coxeter_dimension_bounds/*
!/arxiv/sharp_dimension_bounds_8_and_4/main.tex
!/arxiv/ideal_four_dimensional_volume_and_structure/main.tex
!/arxiv/hyperbolic_coxeter_dimension_bounds/main.tex
!/arxiv/sharp_dimension_bounds_8_and_4/references.bib
!/arxiv/ideal_four_dimensional_volume_and_structure/references.bib
!/arxiv/hyperbolic_coxeter_dimension_bounds/references.bib
!/arxiv/sharp_dimension_bounds_8_and_4/main.bbl
!/arxiv/ideal_four_dimensional_volume_and_structure/main.bbl
!/arxiv/hyperbolic_coxeter_dimension_bounds/main.bbl
_build/
/build/

# Lean compiler objects, dependency checkouts and local runtime work.
/formal/.lake/
/formal/.proof-batches/
*.olean
*.olean.hash
*.ilean
*.ilean.hash
*.trace
*.o
*.bc
*.ir
*.setup.json
*.so
*.dylib
*.dll
*.a
*.exe
*.partial
*.download
*.tmp
*.sqlite-shm
*.sqlite-wal
/formal/**/*.c
/formal/**/*.c.hash

# TeX intermediates. Final PDFs and recorded verification receipts are sources
# of publication evidence and are intentionally retained.
*.aux
*.toc
*.lof
*.lot
*.fls
*.blg
*.fdb_latexmk
*.synctex.gz
*.synctex
*.nav
*.snm
*.vrb
*.xdv
/manuscripts/build/*.log
/manuscripts/build/*.out

# Local coordination/session history; all originals remain on disk.
/.singularhistory
/GOAL.md
/RESEARCH_PLAN.md
/scratch_n7_orbits.py
/surface
/docs/history/

# Exact bulk-data paths below are generated from the release manifest.
# They are kept in release assets instead of Git.

# Administrative instruction snapshots remain local.
/results/source_archive/**/AGENTS*
/results/source_archive/**/agents*

# Downloaded literature/data: retain provenance, retrieve from original sources.
/data/external/**
!/data/external/**/
!/data/external/**/README.md
/references/fresh_dimension_new_mechanisms_20261014_h7_diagram.pdf


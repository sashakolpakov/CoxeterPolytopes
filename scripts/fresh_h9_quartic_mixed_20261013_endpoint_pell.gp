default(parisizemax,1000000000);
default(realprecision,80);
f=y^4-4*y^2+2;
p=x^8+24*x^6+72*x^4-864*x^2-1296;
k=bnfinit(f,1);b=bnfinit(p,1);
print("absolute_signature=",b.sign);
us=b.fu;
lift_even(v)=Mod(sum(j=0,3,polcoef(v,2*j)*(6*(y-1))^j),f);
ns=vector(#us,j,lift_even(lift(Mod(lift(us[j]),p)*Mod(subst(lift(us[j]),x,-x),p))));
es=vector(#us,j,bnfisunit(k,ns[j]));
m=matrix(3,#us,i,j,es[j][i]);ker=matkerint(m);
print("relative_kernel=",ker);
e=Mod(1,p);for(j=1,#us,e*=Mod(lift(us[j]),p)^ker[j,1]);
if(e*Mod(subst(lift(e),x,-x),p)!=1,error("relative norm not one"));
isint(v)=vector(4,j,denominator(polcoef(lift(v),j-1)))==[1,1,1,1];
chosen=0;
for(power=1,1000,ee=e^power;v=lift(ee);yy=lift_even(v);ss=lift_even(sum(j=0,3,polcoef(v,2*j+1)*x^(2*j)));if(isint(yy)&&isint(ss)&&isint((yy-1)/2),chosen=power;break));
if(chosen==0,error("congruence power bound exhausted"));
if(yy^2-6*Mod(y-1,f)*ss^2!=1,error("Pell equation failed"));
print("congruence_power=",chosen);
print("{\"y\":",vector(4,j,Str(polcoef(lift(yy),j-1))),",\"s\":",vector(4,j,Str(polcoef(lift(ss),j-1))),",\"power\":",chosen,"}");

  "certificate_sha256": "d5efd409cf5d5a5a62e9784f8c9e71eebb5a08ee20e8ea7f1d05e894d305a183",
  "claim": "H9/14 records 43, 44, and 47 are nerves of ordinary convex simple 9-polytopes with 14 facets.",
  "construction": "For each record, the nerve is the join of the boundary of a 4-simplex with a simplicial multiwedge of a small polytopal sphere. Dually, take the product of a 4-simplex with successive facet wedges of the dual base simple polytope.",
  "kind": "h9_14_multiwedge_ordinary_polytopality",
  "nonclaims": [
    "No Coxeter labels are supplied.",
    "No Lorentzian Coxeter Gram matrix is supplied.",
    "Ordinary polytopality does not imply hyperbolic Coxeter realizability.",
    "The toric divisor intersection ring does not by itself encode Coxeter angles."
  ],
  "proof_lemma": {
    "primary_reference": "S. Choi and H. Park, Wedge Operations and Torus Symmetries, Tohoku Math. J. 68 (2016), Proposition 2.2(3) and Lemma 2.3",
    "statement": "A facet wedge of a simple convex polytope is again simple and convex, and its dual boundary is the simplicial wedge. Iteration realizes every positive integral multiwedge. Joins of simplicial polytope boundaries are polytopal.",
    "url": "https://www.jstage.jst.go.jp/article/tmj/68/1/68_1458248864/_pdf"
  },

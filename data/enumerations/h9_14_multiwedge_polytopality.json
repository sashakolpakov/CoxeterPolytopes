{
  "algebro_geometric_corollary": {
    "base_models": {
      "43": "the dual stacking sequence realized by toric corner cuts of a large integral Delzant tetrahedron, including the final cut at the new vertex {u,11,12}",
      "44": "an integral Delzant hexagon, for example the moment polygon of the blow-up of P^2 at its three torus fixed points",
      "47": "the dual stacking sequence realized by toric corner cuts at {u,1,2}, {u,2,11}, and {u,1,11}"
    },
    "carrier_caveat": "The labelled incidence complex is canonical for the toric boundary pair (X,D), or for a distinguished toric presentation; the abstract variety or abstract graded Chow ring alone need not recover the boundary labels.",
    "chow_ring": "A^*(X) is Z[x_0,...,x_13]/(I_lin + I_SR), where I_SR is generated exactly by the six quadratic and four quintic squarefree monomials of the archived minimal nonfaces.",
    "claim": "For each record there is a smooth projective toric 9-fold X of Picard rank five whose reduced toric boundary D is SNC, satisfies K_X + D = 0, and has dual intersection complex equal to the target nerve.",
    "delzant_wedge": "With a primitive integral slack ell_F, use 0 <= t <= ell_F(x). The new primitive inward normals are e_{d+1} and (a_F,-1); together with the old normals they form a lattice basis at every new vertex. Primitive coefficient one is essential: replacing ell_F by k ell_F can introduce index k.",
    "divisor_encoding": "The fourteen torus-invariant prime divisors correspond to facets. A set has nonempty intersection exactly when its rays span a fan cone, equivalently when the corresponding moment-polytope facets have a common face. Thus Dual(D) is the nerve.",
    "picard_rank": 5,
    "polarized_toric_dictionary": {
      "compactness": "An ample toric divisor H has a compact moment polytope Q; ordinary polytope compactness is projectivity plus the choice of polarization.",
      "coxeter_caveat": "These ordinary volumes and relation spaces do not supply the rank-ten Lorentzian Coxeter form, angle labels, or hyperbolic chamber volume.",
      "facet_intersection": "H^8 D_i = 8! times the lattice-normalized volume of the facet corresponding to D_i.",
      "gale_rank": "Pic(X)_R = R^14/M_R has dimension five; quotienting by the polarization/support class has dimension four, equal to the Gale rank 14-9-1.",
      "invariant_measure": "The moment-map pushforward of symplectic volume is the Duistermaat--Heckman/Lebesgue measure on Q.",
      "top_intersection": "H^9 = 9! times the lattice-normalized volume of Q."
    },
    "product": "After the facet wedges, take the product with a Delzant 4-simplex. The result has dimension nine and fourteen facets."
  },

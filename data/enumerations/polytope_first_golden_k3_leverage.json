  "paired_root_arithmetic": {
    "geometric_scope": "for a generic restricted facet in an even root-complete package, shell uniqueness leaves a local A1+A1 root system; Weyl framing makes its two simple roots irreducible curves",
    "root_trace_square": -2,
    "trace_pairing": 0,
    "unit_partner": "phi-1",
    "unit_partner_trace_square": -2
  },
  "schema_version": "1.0.0",
  "theorem_scope": {
    "automatic_result": "every root-complete package in H2-H4 has a full-Picard K3 eigen-nef realization; compact Lanner seeds make the class nonempty and non-singleton",
    "compactness_bound_scope": "the two embedded field norms are the finitely many positive constants sigma(t) from the five-shell list, not uniformly 2",
    "embedding_orbit_scope": "Nikulin local discriminant forms decide existence/complement genera; O(Lambda_K3)-orbit enumeration additionally requires complement isometry classes and discriminant anti-isometry double cosets",
    "external_theorems": [
      "Nikulin stable primitive-embedding theorem",
      "surjectivity of the marked K3 period map",
      "K3 Weyl-chamber transitivity and Riemann-Roch",
      "local finiteness of fixed-shell arithmetic mirrors"
    ],
    "input": "fixed compact even norm-two Z[phi] Coxeter realization; not an abstract diagram with unenumerated normal scalings",
    "nonexistence_scope": "O-stable integral full-trace golden quadratic K3 carriers, not arithmetic Coxeter polytopes themselves, are impossible from H10 onward",
    "stable_result": "ell(A_N)<=18-2n is sufficient through H8; Bugaenko realizes equality at n=8",
    "trace_even_wall_scope": "for a general trace-even overclosure, visible roots range over the finite five-shell list and equality with P must be tested explicitly; identification with the norm-two field arrangement is restricted to field-even packages"
  },
  "verified": true

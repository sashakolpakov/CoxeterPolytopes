{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coxeter-polytopes.local/schemas/golden-element.schema.json",
  "title": "Exact Q(sqrt(5)) element in the basis 1, phi",
  "type": "object",
  "required": ["a", "b"],
  "properties": {
    "a": {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"},
    "b": {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"}
  },
  "additionalProperties": false
}

